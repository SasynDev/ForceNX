# VISUAL STUDIO - USER-SPECIFIC FILES
# ============================================================

*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs
*.sln.ide
*.env

# Mono crash reports
mono_crash.*

